{
  "name": "dontsliceme-android",
  "version": "0.32.8",
  "private": true,
  "description": "Android shell for Don't Slice Me! (Capacitor 8 + AdMob + RevenueCat). The app's own version lives in android/app/build.gradle (versionName, versionCode).",
  "engines": { "node": ">=22" },
  "scripts": {
    "www": "node copy-www.cjs",
    "sync": "npm run www && npx cap sync android",
    "open": "npx cap open android",
    "check": "node copy-www.cjs --check",
    "assets": "capacitor-assets generate --android"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "@capacitor/push-notifications": "8.1.3",
    "@capacitor/share": "8.0.3",
    "@capacitor-community/admob": "8.3.0",
    "@revenuecat/purchases-capacitor": "14.1.0"
  },
  "devDependencies": {
    "@capacitor/assets": "4.0.0",
    "@capacitor/cli": "8.6.0"
  }
}
