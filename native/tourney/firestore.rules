rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Everything is written by the Cloud Function (admin SDK); clients only read their own result and the open ladders.
    match /groups/{group} { allow read: if request.auth != null; allow write: if false;
      match /scores/{uid} { allow read: if request.auth != null; allow write: if false; } }
    match /players/{uid} { allow read: if request.auth != null && request.auth.uid == uid; allow write: if false; }
    match /results/{uid} { allow read: if request.auth != null && request.auth.uid == uid; allow write: if false; }
    match /meters/{week} { allow read: if request.auth != null; allow write: if false; }
    // Profiles, friend codes, friendships and pending rewards: only through the function.
    match /profiles/{uid} { allow read, write: if false; }
    match /codes/{code} { allow read, write: if false; }
    match /friends/{uid}/{document=**} { allow read, write: if false; }
    match /saves/{uid} { allow read, write: if false; }
    match /saves/{uid}/history/{day} { allow read, write: if false; }
    match /links/{code} { allow read, write: if false; }
    match /devices/{uid} { allow read, write: if false; }
    match /duels/{day}/{document=**} { allow read, write: if false; }
    match /tips/{id} { allow read, write: if false; }
    // v0.32: ghosts, the hourly duel limit, rate limits, friend requests (and refusals), friend duels, ghost summaries, paid pairs
    match /ghosts/{id} { allow read, write: if false; }
    match /duelwin/{uid} { allow read, write: if false; }
    match /limits/{key} { allow read, write: if false; }
    match /requests/{uid}/{document=**} { allow read, write: if false; }
    match /challenges/{id} { allow read, write: if false; }
    match /duelsum/{uid} { allow read, write: if false; }
    match /pairs/{id} { allow read, write: if false; }
    // v0.32.5 live duels: invites, lobbies (and their live documents), push subscriptions, records and counted wins: only through the function.
    match /ldinv/{id} { allow read, write: if false; }
    match /ldlobby/{id}/{document=**} { allow read, write: if false; }
    match /ldpush/{uid} { allow read, write: if false; }
    match /h2h/{id} { allow read, write: if false; }
    match /duelstats/{uid} { allow read, write: if false; }
    // v0.32.9 player names: reports, report totals and block lists: only through the function.
    match /reports/{id} { allow read, write: if false; }
    match /repsum/{uid} { allow read, write: if false; }
    match /blocks/{uid} { allow read, write: if false; }
    // v0.32.8 own statistics: daily totals only (no player data), written by the function; readable only by the owner's verified Google account (stats.html)
    match /stats/{day} { allow read: if request.auth != null && request.auth.token.email == 'dont.slice.me@gmail.com' && request.auth.token.email_verified == true; allow write: if false; }
  }
}
